{
  "name": "@light-keeper/api",
  "version": "0.1.0",
  "private": true,
  "description": "Игровой сервер Light Keeper",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include ../shared/src --env-file=.env.development src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --sourcemap --outfile=dist/index.js \"--banner:js=import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@light-keeper/shared": "*",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2"
  }
}
